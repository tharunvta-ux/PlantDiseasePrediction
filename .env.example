# Copy to `.env` (git-ignored) and fill in. Never commit real keys.

# --- LLM (treatment guidance) ---
LLM_PROVIDER=gemini
# Create a key at https://aistudio.google.com/apikey
LLM_API_KEY=
# Stable Gemini model with a free tier (verified 2026-09-30).
# Alternative free-tier option: gemini-3.5-flash-lite
LLM_MODEL=gemini-3.8-flash
# Tried once if the main model is overloaded (503) or rate-limited (429).
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
# Read-aloud for non-English guidance (Gemini text-to-speech, free tier).
LLM_TTS_MODEL=gemini-3.8-flash-lite-tts
LLM_TTS_FALLBACK_MODEL=gemini-3.8-flash-tts
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2

# --- Accounts / treatment history ---
# Signs the login cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Empty = local SQLite file instance/verdant.db.
# Production: a Postgres URL from Neon / Supabase, e.g.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
# Set to true when served over HTTPS.
# SESSION_COOKIE_SECURE=true

# --- Model (optional) ---
# MODEL_PATH=saved_models/plant_disease_cnn.keras
